COMMA                : 5 9 9
DIVIDE               : 13
EQ                   : 16
EQUALS               : 4
FOR                  : 9
GE                   : 19
GT                   : 15
LBRACE               : 9
LE                   : 18
LIN                  : 5
LPAREN               : 5 6 7 9 21
LT                   : 14
MINUS                : 11 20
NAME                 : 4 23
NE                   : 17
NUMBER               : 22
PLUS                 : 10
RBRACE               : 9
