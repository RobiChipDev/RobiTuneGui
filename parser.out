Rule 17    expression -> expression NE expression
Rule 18    expression -> expression LE expression
Rule 19    expression -> expression GE expression
Rule 20    expression -> MINUS expression
Rule 21    expression -> LPAREN expression RPAREN
Rule 22    expression -> NUMBER
Rule 23    expression -> NAME

